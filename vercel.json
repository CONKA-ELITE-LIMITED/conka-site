{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/auth/subscriptions/[id]/pause/route.ts": {
      "maxDuration": 30
    },
    "app/api/auth/subscriptions/[id]/resume/route.ts": {
      "maxDuration": 30
    },
    "app/api/auth/subscriptions/[id]/cancel/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/blog-publish",
      "schedule": "0 5-23 * * *"
    }
  ]
}
